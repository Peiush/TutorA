// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum TutorProfileStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TutorRequestStatus {
  OPEN
  MATCHED
  CLOSED
}

enum CourseCategory {
  PROGRAMMING_TECHNOLOGY
  TEST_PREPARATION
  LANGUAGES
  CREATIVE_SKILLS
  MUSIC_INSTRUMENTS
}

enum CourseGradeBand {
  GRADE_6_8
  GRADE_8_10
  GRADE_11_12
  ALL_GRADES
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ALL_LEVELS
}

enum CourseRequestStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          Role      @default(STUDENT)

  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  tutorProfile    TutorProfile?
  tutorRequests   TutorRequest[]
  matchedRequests TutorRequest[]  @relation("MatchedTutorRequests")
  savedTutors     SavedTutor[]
  savedCourses    SavedCourse[]
  savedSubjects   SavedSubject[]
  courseRequests  CourseRequest[]
  subjectRequests SubjectRequest[]
  conversations   Conversation[]
  phoneOtp        PhoneOtp?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model TutorProfile {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String             @unique
  country         String
  subjects        String
  yearsExperience Int?
  hourlyRateCents Int?
  bio             String?
  certificateUrl  String?
  status          TutorProfileStatus @default(PENDING)
  savedBy         SavedTutor[]
  courses         Course[]
  subjectListings TutorSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@map("tutor_profiles")
}

model Subject {
  id              String         @id @default(cuid())
  name            String         @unique
  gradeLevel      String?
  curriculum      String?
  hourlyRateCents Int?
  title           String?
  subtitle        String?
  durationLabel   String?
  whatYoullLearn  String?
  tutorListings   TutorSubject[]
  savedBy         SavedSubject[]
  requests        SubjectRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

model TutorSubject {
  id              String       @id @default(cuid())
  tutorProfileId  String
  tutorProfile    TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  hourlyRateCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tutorProfileId, subjectId])
  @@map("tutor_subjects")
}

model SavedTutor {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, tutorProfileId])
  @@map("saved_tutors")
}

model TutorRequest {
  id                      String             @id @default(cuid())
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                    String
  email                   String
  phone                   String?
  subject                 String
  level                   String?
  goals                   String?
  mode                    String?
  sessionsPerWeek         String?
  timezone                String?
  currency                String?
  budgetPerHour           Int?
  notes                   String?
  status                  TutorRequestStatus @default(OPEN)
  requestedTutorName      String?
  requestedTutorRate      String?
  requestedTutorProfileId String?
  matchedTutorId          String?
  matchedTutor            User?              @relation("MatchedTutorRequests", fields: [matchedTutorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tutor_requests")
}

model Course {
  id                 String          @id @default(cuid())
  slug               String          @unique
  title              String
  subtitle           String?
  instructorId       String?
  instructor         TutorProfile?   @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  category           CourseCategory
  level              CourseLevel     @default(ALL_LEVELS)
  gradeBand          CourseGradeBand @default(ALL_GRADES)
  rating             Float           @default(4.8)
  reviewCount        Int             @default(0)
  priceCents         Int?
  originalPriceCents Int?
  durationHours      Float?
  lectureCount       Int?
  lectureCountLabel  String?
  whatYoullLearn     String?
  bestseller         Boolean         @default(false)
  premium            Boolean         @default(false)
  isNew              Boolean         @default(false)
  published          Boolean         @default(true)
  savedBy            SavedCourse[]
  requests           CourseRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@index([published, category, rating])
  @@map("courses")
}

model SavedCourse {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("saved_courses")
}

model SavedSubject {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, subjectId])
  @@map("saved_subjects")
}

model CourseRequest {
  id       String              @id @default(cuid())
  userId   String
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status   CourseRequestStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("course_requests")
}

model SubjectRequest {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  status    CourseRequestStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, subjectId])
  @@map("subject_requests")
}

model PhoneOtp {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("phone_otps")
}

model Conversation {
  id            String            @id @default(cuid())
  phone         String            @unique
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime          @default(now())
  messages      WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
}

model WhatsAppMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  waMessageId    String?          @unique
  body           String
  status         MessageStatus    @default(QUEUED)
  payload        Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("whatsapp_messages")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
